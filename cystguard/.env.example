# Production/hosted database URL (Supabase PostgreSQL). Replace placeholders locally.
# URL-encode reserved characters in the password. For local SQLite, leave this blank.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@HOST:5432/postgres?sslmode=require

# Optional; only used by the opt-in PostgreSQL integration test. Use a disposable database.
TEST_DATABASE_URL=

# Generate a unique local value before issuing tokens. Never commit the value.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORAGE_ROOT=
CYSTX_CHECKPOINT_PATH=
CYSTX_SOURCE_PATH=
CYSTX_MODEL_VERSION=cystx-baseline-v1
CYSTX_DIAGNOSTICS_ENABLED=false
FOODCNN_CHECKPOINT_PATH=backend/vendor/FoodCNN/best_finetuned_combined_model.pth
FOODCNN_MODEL_VERSION=FoodCNN@2c944166f988acff4374d131b8b1fe535a64abf6
MAX_MEAL_UPLOAD_SIZE_MB=12
MAX_MRI_UPLOAD_SIZE_MB=512
MAX_DOCUMENT_UPLOAD_SIZE_MB=25
TESSERACT_CMD=
SARVAM_API_KEY=
SARVAM_API_URL=https://api.sarvam.ai/v1/chat/completions
SARVAM_MODEL=sarvam-105b
SARVAM_TIMEOUT_SECONDS=12
