{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react",
    "strict": true, "noEmit": false, "allowJs": true, "checkJs": false,
    "skipLibCheck": true, "rootDir": "src", "outDir": "dist"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.js"]
}
